    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\n\n// Converts placeholder junk values into real null\nconst clean = (val) => {\n  if (val === null || val === undefined) return null;\n  if (typeof val === 'string') {\n    const trimmed = val.trim();\n    if (trimmed === '' || trimmed === '-' || trimmed.toLowerCase() === 'null') {\n      return null;\n    }\n    return trimmed;\n  }\n  if (Array.isArray(val)) {\n    // e.g. aliases: [\"-\"] should become null, not [\"-\"]\n    const cleanedArr = val.map(clean).filter(v => v !== null);\n    return cleanedArr.length ? cleanedArr : null;\n  }\n  return val;\n};\n\n// Helper for numeric stat fields — cleans, then converts to number or null\nconst cleanNumber = (val) => {\n  const c = clean(val);\n  return c === null ? null : Number(c);\n};\n\n// height/weight come as [\"5'8\\\"\", \"173 cm\"] — split imperial vs metric\nconst firstOrNull = (arr) => {\n  const c = clean(arr);\n  return c ? c[0] : null;\n};\nconst secondOrNull = (arr) => {\n  const c = clean(arr);\n  return c && c.length > 1 ? c[1] : null;\n};\n\nreturn {\n  json: {\n    id: item.id ?? null,\n    name: clean(item.name),\n\n    // powerstats\n    intelligence: cleanNumber(item.powerstats?.intelligence),\n    strength: cleanNumber(item.powerstats?.strength),\n    speed: cleanNumber(item.powerstats?.speed),\n    durability: cleanNumber(item.powerstats?.durability),\n    power: cleanNumber(item.powerstats?.power),\n    combat: cleanNumber(item.powerstats?.combat),\n\n    // biography\n    full_name: clean(item.biography?.['full-name']),\n    alter_egos: clean(item.biography?.['alter-egos']),\n    aliases: clean(item.biography?.aliases)?.join(', ') ?? null,\n    place_of_birth: clean(item.biography?.['place-of-birth']),\n    first_appearance: clean(item.biography?.['first-appearance']),\n    publisher: clean(item.biography?.publisher),\n    alignment: clean(item.biography?.alignment),\n\n    // appearance\n    gender: clean(item.appearance?.gender),\n    race: clean(item.appearance?.race),\n    height_imperial: firstOrNull(item.appearance?.height),\n    height_metric: secondOrNull(item.appearance?.height),\n    weight_imperial: firstOrNull(item.appearance?.weight),\n    weight_metric: secondOrNull(item.appearance?.weight),\n    eye_color: clean(item.appearance?.['eye-color']),\n    hair_color: clean(item.appearance?.['hair-color']),\n\n    // work\n    occupation: clean(item.work?.occupation),\n    base: clean(item.work?.base),\n\n    // connections\n    group_affiliation: clean(item.connections?.['group-affiliation']),\n    relatives: clean(item.connections?.relatives),\n\n    // image\n    image_url: clean(item.image?.url)\n  }\n};"
      },
